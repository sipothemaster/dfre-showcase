---
import BaseLayout from '../layouts/BaseLayout.astro';
import haspLogo from '../assets/brand/hasp/hasp-data-service.png';
import '../styles/explorer-hasp.css';
import 'maplibre-gl/dist/maplibre-gl.css';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout
	title="Delivery availability explorer · HASP Data Service"
	description="Explore neighbourhood-level restaurant, fast-food and grocery delivery indicators across Great Britain."
>
	<main id="main-content" class="explorer-page hasp-explorer" data-base={base}>
		<header class="explorer-header">
			<div class="explorer-brand-copy">
				<h1>Delivery availability explorer</h1>
				<p>Neighbourhood-level delivery indicators</p>
			</div>
			<a
				class="hasp-brand-link"
				href="https://hasp.ac.uk/"
				target="_blank"
				rel="noreferrer"
				aria-label="Healthy and Sustainable Places Data Service website"
			>
				<img src={haspLogo.src} width="180" height="52" alt="Healthy and Sustainable Places Data Service" />
			</a>
		</header>

		<div class="explorer-workspace">
			<aside class="explorer-controls" aria-label="Explorer controls">
				<section class="explorer-sidebar-section explorer-view-switch" aria-labelledby="view-heading">
					<h2 id="view-heading" class="explorer-sidebar-label">View</h2>
					<p class="explorer-sidebar-help">Choose how to explore the data.</p>
					<div class="explorer-view-options" role="tablist" aria-label="Explorer view">
						<button
							id="view-map-button"
							class="explorer-view-option is-selected"
							type="button"
							role="tab"
							aria-selected="true"
							aria-controls="explorer-map-view"
							data-explorer-view="map"
						>
							<span class="view-radio" aria-hidden="true"></span>
							Explore map
						</button>
						<button
							id="view-about-button"
							class="explorer-view-option"
							type="button"
							role="tab"
							aria-selected="false"
							aria-controls="explorer-about-view"
							data-explorer-view="about"
						>
							<span class="view-radio" aria-hidden="true"></span>
							About the data
						</button>
					</div>
				</section>

				<div id="map-control-groups">
					<section class="explorer-sidebar-section" aria-labelledby="metric-heading">
						<h2 id="metric-heading" class="explorer-sidebar-label">Map metric</h2>
						<p class="explorer-sidebar-help">Select the delivery measure to display.</p>
						<div class="explorer-control-group">
							<label for="map-metric">Indicator</label>
							<select id="map-metric">
								<option value="fc" selected>Rapid grocery availability from retailers’ own services</option>
								<option value="open">Deliverable restaurants by time of the day on aggregator platform</option>
								<option value="r">Total deliverable restaurants on aggregator platform</option>
								<option value="ff">Fast food restaurants on aggregator platform</option>
								<option value="ffs">Fast food share on aggregator platform</option>
								<option value="g">On demand grocery listings on aggregator platform</option>
							</select>
						</div>

						<div class="temporal-controls" id="temporal-controls" hidden>
							<div class="explorer-control-group">
								<label for="temporal-day">Day</label>
								<select id="temporal-day">
									<option value="Monday">Monday</option>
									<option value="Tuesday">Tuesday</option>
									<option value="Wednesday">Wednesday</option>
									<option value="Thursday">Thursday</option>
									<option value="Friday" selected>Friday</option>
									<option value="Saturday">Saturday</option>
									<option value="Sunday">Sunday</option>
								</select>
							</div>

							<div class="explorer-control-group temporal-hour-control">
								<div class="temporal-hour-label">
									<label for="temporal-hour">Hour</label>
									<output id="temporal-hour-output" for="temporal-hour">20:00</output>
								</div>
								<input id="temporal-hour" type="range" min="0" max="23" step="1" value="20" />
								<div class="temporal-hour-scale" aria-hidden="true"><span>00</span><span>06</span><span>12</span><span>18</span><span>23</span></div>
							</div>
						</div>
					</section>

					<section class="explorer-sidebar-section" aria-labelledby="geography-heading">
						<h2 id="geography-heading" class="explorer-sidebar-label">Geography</h2>
						<p class="explorer-sidebar-help">Choose a local authority for small-area detail.</p>
						<div class="explorer-control-group">
							<label for="lad-search">Local authority</label>
							<select id="lad-search" disabled>
								<option value="">Loading areas…</option>
							</select>
						</div>
						<button id="clear-area" class="explorer-secondary-button" type="button" disabled>Return to Great Britain</button>
					</section>

					<section class="explorer-sidebar-section explorer-legend-section" aria-labelledby="legend-heading">
						<h2 id="legend-heading" class="explorer-sidebar-label">Legend</h2>
						<div class="map-legend" id="map-legend" aria-live="polite"></div>
						<p class="explorer-instruction">At national scale, colours summarise local-authority values. Select an area to load LSOA or Data Zone detail.</p>
					</section>
				</div>
			</aside>

			<section
				id="explorer-map-view"
				class="explorer-main-view"
				role="tabpanel"
				aria-labelledby="view-map-button"
			>
				<div class="explorer-map-heading">
					<div>
						<p class="explorer-main-kicker">Interactive map</p>
						<h2>Explore availability of delivered food and on-demand groceries from a major aggregator platform and retailers’ own services.</h2>
					</div>
					<p>Great Britain · representative-postcode design</p>
				</div>

				<div class="map-panel">
					<div class="map-frame">
						<div id="map" aria-label="Interactive map of delivery availability"></div>
						<div class="map-loading" id="map-loading" role="status">Loading map data…</div>
					</div>

					<aside class="area-profile" id="area-profile" aria-live="polite">
						<p class="profile-kicker">Great Britain overview</p>
						<h2>Select a local authority</h2>
						<p>Click the map or use the area selector to load small-area detail and exact values.</p>
						<div class="profile-method">
							<strong>How to read this map</strong>
							<p>At national scale, the map shows the mean values (across all neighbourhoods) for the chosen indicator by local authority. Select a single local authority to explore these data at the LSOA or Data Zone level.</p>
						</div>
					</aside>
				</div>
			</section>

			<section
				id="explorer-about-view"
				class="explorer-main-view explorer-about-view"
				role="tabpanel"
				aria-labelledby="view-about-button"
				hidden
			>
				<div class="about-intro">
					<p class="explorer-main-kicker">About this tool</p>
					<h2>Delivery availability explorer</h2>
					<p class="about-lead">Use this tool to see how restaurant and rapid grocery delivery availability varies between neighbourhoods across Great Britain.</p>
					<p>Start with the national map, select a local authority, then click an LSOA or Data Zone to see the values observed for its representative postcode.</p>
				</div>

				<hr />

				<section aria-labelledby="measure-heading">
					<h3 id="measure-heading">What each measure shows</h3>
					<div class="about-card-grid">
						<article class="about-card">
							<h4>Rapid grocery availability (60-min delivery)</h4>
							<p><strong>Measures:</strong> how many of three monitored rapid grocery services were observed as available.</p>
							<p><strong>Read as:</strong> no, low, medium or high coverage. Individual retailer names and service states are not shown.</p>
						</article>
						<article class="about-card">
							<h4>Restaurant availability on aggregator platform</h4>
							<p><strong>Measures:</strong> distinct restaurants available for delivery, fast-food restaurants and fast-food share.</p>
							<p><strong>Read as:</strong> fast-food share is the number of deliverable restaurants classified as fast food divided by all deliverable restaurants after retail exclusions. At local-authority level, the calculation pools restaurant counts across all neighbourhoods before calculating the share.</p>
						</article>
						<article class="about-card">
							<h4>Deliverable restaurants by time of the day on aggregator platform</h4>
							<p><strong>Measures:</strong> restaurants scheduled to be open for delivery at the selected day and hour.</p>
							<p><strong>Read as:</strong> restaurants with missing schedules are excluded from the confirmed-open count; they are not assumed to be closed.</p>
						</article>
						<article class="about-card">
							<h4>On demand grocery listings on aggregator platform</h4>
							<p><strong>Measures:</strong> grocery listings observed on the delivery platform for the representative postcode.</p>
							<p><strong>Read as:</strong> a listing count, kept separate from the rapid grocery coverage measure.</p>
						</article>
					</div>
				</section>

				<hr />

				<section aria-labelledby="use-heading">
					<h3 id="use-heading">How to use this tool</h3>
					<div class="about-instructions">
						<details open>
							<summary>Explore a local authority</summary>
							<div>
								<p>Select an area on the map or choose it from the Local authority menu. The map will zoom in and load its LSOA or Data Zone boundaries.</p>
								<p>Click a small area to open its exact values in the lower-left information card. Use “Return to Great Britain” to reset the map.</p>
							</div>
						</details>
						<details>
							<summary>Read rapid grocery availability</summary>
							<div>
								<p>At national scale, each local authority is coloured by the mean rapid grocery coverage across its neighbourhoods, ranging from no coverage to high coverage.</p>
								<p>After selecting a local authority, every small area is classified as having no, low, medium or high coverage. Unresolved observations remain separate and are not counted as unavailable.</p>
							</div>
						</details>
						<details>
							<summary>Compare delivery measures</summary>
							<div>
								<p>Use the Indicator menu to switch between rapid grocery, restaurant, fast-food and grocery-listing measures. The geography remains fixed so patterns can be compared across the same area.</p>
								<p>National restaurant and listing values summarise small areas. Selecting a local authority reveals exact small-area values.</p>
							</div>
						</details>
						<details>
							<summary>Check availability by day and hour</summary>
							<div>
								<p>Select “Deliverable restaurants by time of the day on aggregator platform”, then choose a day and hour. The map shows the number of restaurants confirmed by their recorded schedules to be open for delivery at that time.</p>
							</div>
						</details>
					</div>
				</section>

				<section class="about-source-note" aria-labelledby="sources-heading">
					<h3 id="sources-heading">Data sources</h3>
					<ul class="about-source-list">
						<li><strong>Digital delivery platform:</strong> restaurant listings, delivery coverage and recorded opening schedules from the DFRE platform collection pipeline. <span class="source-status">Planned for deployment on HASP</span></li>
						<li>
							<strong>Grocery retailer delivery:</strong> rapid-delivery availability from three monitored retailer-operated services.
							<span class="source-status">Planned for deployment on HASP</span>
						</li>
						<li><strong>Small-area geography:</strong> ONS LSOA 2021 boundaries for England and Wales and Scottish Government Data Zone 2022 boundaries for Scotland. LAD 2024 boundaries support the national overview.</li>
						<li><strong>Population:</strong> ONS mid-2024 small-area population estimates for England and Wales and 2022 Data Zone total population for Scotland.</li>
					</ul>
					<a class="about-primary-link" href={`${base}#pipeline`}>Read the full methods and data pipeline</a>
				</section>

				<section class="about-citation" aria-labelledby="citation-heading">
					<h3 id="citation-heading">Suggested citation</h3>
					<p class="citation-text">
						Xiao, C., Newing, A. and Nield, L. 2026.{' '}
						<cite>Delivery Availability Explorer</cite>. Data asset prepared for the Healthy &amp; Sustainable Places Data Service.
						Available at: <a href="https://sipothemaster.github.io/dfre-showcase/explore/">https://sipothemaster.github.io/dfre-showcase/explore/</a>.
					</p>
					<p class="citation-note">Please also cite the underlying delivery, geography and population data sources listed above.</p>
				</section>
			</section>
		</div>
	</main>

	<script>
		import '../scripts/explorer';

		const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-explorer-view]'));
		const mapView = document.querySelector<HTMLElement>('#explorer-map-view');
		const aboutView = document.querySelector<HTMLElement>('#explorer-about-view');
		const mapControlGroups = document.querySelector<HTMLElement>('#map-control-groups');

		function selectExplorerView(view: 'map' | 'about') {
			viewButtons.forEach((button) => {
				const selected = button.dataset.explorerView === view;
				button.classList.toggle('is-selected', selected);
				button.setAttribute('aria-selected', String(selected));
			});

			if (mapView) mapView.hidden = view !== 'map';
			if (aboutView) aboutView.hidden = view !== 'about';
			if (mapControlGroups) mapControlGroups.hidden = view !== 'map';

			if (view === 'map') {
				requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
			}
		}

		viewButtons.forEach((button) => {
			button.addEventListener('click', () => {
				selectExplorerView(button.dataset.explorerView === 'about' ? 'about' : 'map');
			});
		});
	</script>
</BaseLayout>
