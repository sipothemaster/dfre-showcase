<figure class="data-architecture compact-architecture" aria-labelledby="data-architecture-title">
	<figcaption id="data-architecture-title" class="visually-hidden">
		Representative-postcode design, reusable cloud collection, storage and core delivery datasets
	</figcaption>

	<section class="architecture-band compact-workflow" aria-labelledby="workflow-title">
		<header class="architecture-band-header">
			<div>
				<p class="architecture-kicker">Data architecture</p>
				<h3 id="workflow-title">Spatial delivery data pipeline</h3>
			</div>
			<a class="repository-link" href="https://github.com/sipothemaster/delivery-availability-pipeline" target="_blank" rel="noreferrer">
				delivery-availability-pipeline <span aria-hidden="true">↗</span>
			</a>
		</header>

		<div class="research-flow">
		<section class="research-stage geography-module" aria-labelledby="geography-module-title">
			<header>
				<p id="geography-module-title"><span>01</span> Representative-postcode design</p>
			</header>
			<div class="compact-route geography-route" aria-label="Representative postcode selection">
				<span><strong>LSOA / Data Zone<br />population-weighted centroid</strong></span>
				<b aria-hidden="true">→</b>
				<span><strong>Nearest valid postcode<br />by centroid distance</strong></span>
				<b aria-hidden="true">→</b>
				<span><strong>Representative postcode<br />for all collection services</strong></span>
			</div>
		</section>

		<div class="research-connector" aria-hidden="true"><b>↓</b><span>Postcode input</span></div>

		<section class="research-stage discovery-module" aria-labelledby="discovery-module-title">
			<header>
				<p id="discovery-module-title"><span>02</span> API discovery and reusable collection</p>
			</header>
			<div class="compact-route discovery-route" aria-label="API reverse engineering workflow">
				<span><strong>Observe browser<br />network traffic</strong></span>
				<b aria-hidden="true">→</b>
				<span><strong>Validate the listing API<br />and response schema</strong></span>
				<b aria-hidden="true">→</b>
				<span><strong>Implement a reusable<br />postcode API client</strong></span>
			</div>
		</section>

		<div class="research-connector" aria-hidden="true"><b>↓</b><span>Deploy on GCP</span></div>

		<section class="research-stage gcp-module" aria-labelledby="gcp-module-title">
			<header>
				<p id="gcp-module-title"><span>03</span> GCP execution</p>
			</header>
			<div class="gcp-pair">
				<article>
					<p>Cloud Tasks</p>
					<strong>Postcode/window tasks with rate and concurrency controls</strong>
				</article>
				<article>
					<p>Cloud Run</p>
					<strong>Collection workers for API calls and response parsing</strong>
				</article>
			</div>
		</section>

		<div class="research-connector" aria-hidden="true"><b>↓</b><span>Produce datasets</span></div>

		<section class="research-stage storage-module" aria-labelledby="storage-module-title">
			<header>
				<p id="storage-module-title"><span>04</span> Storage</p>
			</header>
			<div class="storage-pair">
				<article>
					<p>BigQuery</p>
					<strong>Manifest, events, diagnostics and production tables</strong>
				</article>
				<article>
					<p>Cloud Storage</p>
					<strong>Compressed raw JSON responses</strong>
				</article>
			</div>
		</section>
		</div>

		<section class="workflow-module relationship-module" aria-labelledby="relationship-module-title">
			<header>
				<p id="relationship-module-title">Dataset relationships</p>
			</header>
			<div class="relationship-map" aria-label="Representative postcodes feed static restaurant coverage, observed open-now availability and direct grocery availability. Static coverage links to opening schedules and restaurant profiles; observed availability also links to restaurant profiles.">
				<div class="relationship-canvas">
					<div class="relationship-boundary" aria-hidden="true">
						<span class="relationship-zone-label relationship-zone-static">Opening-hours-derived availability</span>
						<span class="relationship-zone-label relationship-zone-observed">Observed open-now availability</span>
						<span class="relationship-zone-label relationship-zone-grocery">Direct grocery availability</span>
					</div>

					<svg class="relationship-lines" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
						<defs>
							<marker id="relationship-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto" markerUnits="userSpaceOnUse">
								<path d="M0.75,0.75 L6,3.5 L0.75,6.25"></path>
							</marker>
						</defs>
						<path d="M240 300 C278 300 260 90 300 90"></path>
						<path d="M240 300 C278 300 260 275 300 275"></path>
						<path d="M240 300 C278 300 260 490 300 490"></path>
						<path d="M630 90 L690 90"></path>
						<path d="M630 90 C670 90 645 275 690 275"></path>
						<path d="M630 275 L690 275"></path>
					</svg>

					<article class="relationship-node relationship-postcode">
						<strong>Representative postcodes</strong>
					</article>
					<article class="relationship-node relationship-full">
						<strong>Static coverage — Postcode × restaurant</strong>
						<p class="relationship-scale">16,534,508 rows</p>
						<p class="relationship-structure">Postcode · restaurant ID · delivery state · fee · minimum order · ETA · drive distance</p>
					</article>
					<article class="relationship-node relationship-opening">
						<strong>Opening schedules — Restaurant × service × time</strong>
						<p class="relationship-scale">Normalised opening intervals</p>
						<p class="relationship-structure">Restaurant ID · service type · day · open/close time · timezone · cross-midnight flag</p>
					</article>
					<article class="relationship-node relationship-live">
						<strong>Observed availability — Postcode × collection window × open restaurant</strong>
						<p class="relationship-scale">30,025,952 rows · Weekday afternoon · Weekday evening · Weekday early hours · Saturday peak</p>
						<p class="relationship-structure">Postcode · restaurant ID · collection window · scheduled time · captured time · live delivery attributes</p>
					</article>
					<article class="relationship-node relationship-profile">
						<strong>Restaurant profile — Restaurant</strong>
						<p class="relationship-scale">100,850 restaurants</p>
						<p class="relationship-structure">Restaurant ID · name · location · cuisine · rating · platform URL</p>
					</article>
					<article class="relationship-node relationship-grocery">
						<strong>Direct grocery availability — Service × LSOA / Data Zone</strong>
						<p class="relationship-scale">6 services × 43,064 areas</p>
						<p class="relationship-structure">Service · area code · availability state · delivery type</p>
					</article>
				</div>
			</div>
		</section>
	</section>
</figure>
