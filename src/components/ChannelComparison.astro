---
import data from '../data/generated/retailer_channel_summary.json';

const categoryClasses: Record<string, string> = {
	'Both channels': 'both',
	'Direct only': 'direct',
	'Just Eat only': 'platform',
	'Neither observed': 'neither',
	'Direct unresolved': 'unresolved',
};

const legend = [
	['Both channels', 'both'],
	['Direct only', 'direct'],
	['Just Eat only', 'platform'],
	['Neither observed', 'neither'],
	['Direct unresolved', 'unresolved'],
];
---

<figure class="channel-figure" aria-labelledby="channel-chart-title">
	<figcaption id="channel-chart-title" class="visually-hidden">
		Percentage of Great Britain small-area markets by direct and Just Eat delivery-channel combination.
	</figcaption>

	<div class="channel-legend" aria-label="Channel categories">
		{legend.map(([label, className]) => (
			<span><i class={`legend-swatch ${className}`}></i>{label}</span>
		))}
	</div>

	<div class="channel-rows">
		{data.comparisons.map((comparison) => {
			const platform = comparison.categories.find((item) => item.category === 'Just Eat only');
			const aria = comparison.categories
				.map((item) => `${item.category}: ${item.percent}%`)
				.join(', ');
			return (
				<div class="channel-row">
					<div class="channel-row-head">
						<div>
							<h3>{comparison.retailer_label}</h3>
							<p>{comparison.direct_service} compared with {comparison.justeat_service}</p>
						</div>
						<p class="platform-value"><strong>{platform?.percent}%</strong> Just Eat only</p>
					</div>
					<div class="channel-bar" role="img" aria-label={`${comparison.retailer_label}. ${aria}`}>
						{comparison.categories.map((item) => item.percent > 0 && (
							<span
								class={`channel-segment ${categoryClasses[item.category]}`}
								style={`--segment-width: ${item.percent}%`}
								title={`${item.category}: ${item.percent}%`}
							></span>
						))}
					</div>
				</div>
			);
		})}
	</div>

	<p class="figure-note">
		Percentages use all 43,064 representative-postcode markets. “Just Eat only” means that the brand was observed on Just Eat while the compared direct service returned No; it does not establish that Just Eat caused an expansion in coverage. Iceland compares standard direct delivery with marketplace delivery and should be interpreted separately from the fast-delivery pairs.
	</p>
</figure>
